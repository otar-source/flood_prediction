<%- include('../partials/header', { title: 'Dashboard - Flood Safe Routes', user: user }) %>

<div class="app-shell">
  <!-- Sidebar (Atlas-inspired) -->
  <aside class="app-sidebar">
    <div class="sidebar-brand">
      <span class="brand-icon">🌊</span>
      <span class="brand-name">FloodSafe</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-item active">
        <span class="sidebar-icon">📊</span> Overview
      </a>
      <a href="/report" class="sidebar-item">
        <span class="sidebar-icon">📝</span> Report Flood
      </a>
      <a href="/map" class="sidebar-item">
        <span class="sidebar-icon">🗺️</span> Flood Map
      </a>
      <a href="/route" class="sidebar-item">
        <span class="sidebar-icon">🧭</span> Check Route
      </a>
      <a href="/notifications" class="sidebar-item">
        <span class="sidebar-icon">🔔</span> Notifications
        <span class="sidebar-badge" id="sidebarNotifBadge" style="display:none;">0</span>
      </a>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <span class="user-avatar"><%= user.name.charAt(0) %></span>
        <div class="user-info">
          <span class="user-name"><%= user.name %></span>
          <span class="user-role"><%= user.role %></span>
        </div>
      </div>
      <a href="/logout" class="sidebar-logout">Sign out</a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="app-main">
    <!-- Top Command Bar -->
    <header class="app-header">
      <div class="header-left">
        <h1 class="header-title">Overview</h1>
        <span class="header-subtitle">Welcome back, <%= user.name %></span>
      </div>
      <div class="header-actions">
        <div class="notif-bell-wrap" id="notifBellWrap">
          <button type="button" class="notif-bell" id="notifBellBtn" aria-label="Notifications">
            🔔
            <span class="notif-badge" id="notifBellBadge" style="display:none;">0</span>
          </button>
          <div class="notif-panel" id="notifPanel" style="display:none;">
            <!-- Notification panel content remains the same -->
            <div class="notif-panel-head">
              <strong>Notifications</strong>
              <button type="button" class="notif-panel-close" id="notifPanelClose">✕</button>
            </div>
            <div class="notif-panel-body" id="notifPanelBody">
              <p class="muted">Loading…</p>
            </div>
            <div class="notif-panel-foot">
              <a href="/notifications">View all</a>
              <button type="button" class="linklike" id="notifMarkAllBtn">Mark all read</button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <div class="app-flash">
      <%- include('../partials/messages') %>
    </div>

    <!-- Content Grid (Data Explorer style) -->
    <div class="explorer-layout">
      <!-- Main Data Table Area -->
      <div class="explorer-main">
        <!-- Safe Route Search -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>🔎 Find a Safe Route</h2>
          </div>
          <div class="panel-body">
            <form action="/route" method="GET" class="route-search-form">
              <input type="text" name="origin" placeholder="Origin (e.g., Aba Road)" required>
              <input type="text" name="destination" placeholder="Destination (e.g., Trans-Amadi)" required>
              <button type="submit" class="btn btn-primary">Check Route</button>
            </form>
          </div>
        </div>

        <!-- Recent Verified Reports (Table) -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>✅ Recent Verified Reports</h2>
            <a href="/map" class="panel-link">View on Map →</a>
          </div>
          <div class="panel-body panel-body-flush">
            <% if (recentReports && recentReports.length > 0) { %>
              <table class="data-table data-table-compact">
                <thead>
                  <tr>
                    <th>Road / Location</th>
                    <th>Severity</th>
                    <th>Reported</th>
                    <th>Coordinates</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentReports.forEach(r => { %>
                    <tr>
                      <td class="cell-strong"><%= r.road_name || r.location %></td>
                      <td><span class="badge badge-<%= r.severity.toLowerCase() %>"><%= r.severity %></span></td>
                      <td class="cell-muted"><%= new Date(r.reported_at).toLocaleString() %></td>
                      <td class="cell-mono"><%= r.latitude.toFixed(4) %>, <%= r.longitude.toFixed(4) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <p class="panel-empty">No verified reports yet.</p>
            <% } %>
          </div>
        </div>

        <!-- My Submitted Reports (Table) -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>📋 My Submitted Reports</h2>
          </div>
          <div class="panel-body panel-body-flush">
            <% if (myReports && myReports.length > 0) { %>
              <table class="data-table data-table-compact">
                <thead>
                  <tr>
                    <th>Road / Location</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% myReports.forEach(r => { %>
                    <tr>
                      <td class="cell-strong"><%= r.road_name || r.location %></td>
                      <td><span class="badge badge-<%= r.severity.toLowerCase() %>"><%= r.severity %></span></td>
                      <td><span class="badge badge-status-<%= r.status %>"><%= r.status %></span></td>
                      <td class="cell-muted"><%= new Date(r.reported_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <p class="panel-empty">You haven't submitted any reports yet. <a href="/report">Report a flood</a>.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Side Panel (Widgets) -->
      <div class="explorer-side">
        <!-- Notifications Widget -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>🔔 Recent Alerts</h2>
            <a href="/notifications" class="panel-link">All →</a>
          </div>
          <div class="panel-body" id="dashNotifBox">
            <p class="muted">Loading…</p>
          </div>
        </div>

        <!-- Current Flood Warnings -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>⚠️ Current Warnings</h2>
          </div>
          <div class="panel-body">
            <% if (warnings && warnings.length > 0) { %>
              <ul class="warning-list compact">
                <% warnings.forEach(w => { %>
                  <li class="warning-item risk-<%= w.risk_level.toLowerCase() %> compact">
                    <div class="warning-head">
                      <strong><%= w.location %></strong>
                      <span class="badge badge-<%= w.risk_level.toLowerCase() %>"><%= w.risk_level %></span>
                    </div>
                    <div class="warning-body">
                      <%= w.rainfall_value %> mm · <%= w.confidence %>% confidence
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="panel-empty">No active warnings.</p>
            <% } %>
          </div>
        </div>

        <!-- High-Risk Locations -->
        <div class="data-panel">
          <div class="panel-header">
            <h2>🌧️ High-Risk Zones</h2>
          </div>
          <div class="panel-body panel-body-flush">
            <% if (highRiskLocations && highRiskLocations.length > 0) { %>
              <table class="data-table data-table-compact">
                <thead>
                  <tr>
                    <th>Location</th>
                    <th>Risk</th>
                    <th>Rain</th>
                  </tr>
                </thead>
                <tbody>
                  <% highRiskLocations.forEach(p => { %>
                    <tr>
                      <td class="cell-strong"><%= p.location %></td>
                      <td><span class="badge badge-<%= p.risk_level.toLowerCase() %>"><%= p.risk_level %></span></td>
                      <td class="cell-mono"><%= p.rainfall_value %> mm</td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <p class="panel-empty">No high-risk zones.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Existing scripts remain the same -->
<script>
  (async () => {
    const box = document.getElementById('dashNotifBox');
    if (!box) return;
    try {
      const r = await fetch('/api/notifications', { headers: { Accept: 'application/json' } });
      const d = await r.json();
      const items = (d.notifications || []).slice(0, 3);
      if (!items.length) { box.innerHTML = '<p class="muted">No notifications yet.</p>'; return; }
      const esc = (s) => String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      box.innerHTML = items.map(n => `
        <div class="dash-notif ${n.status === 'unread' ? 'unread' : ''}">
          <div class="dash-notif-title">${esc(n.title)}</div>
          <div class="dash-notif-msg">${esc(n.message)}</div>
          <div class="dash-notif-time">${new Date(n.created_at).toLocaleString()}</div>
        </div>
      `).join('');
    } catch (e) {
      box.innerHTML = '<p class="muted">Failed to load notifications.</p>';
    }
  })();
</script>

<%- include('../partials/footer') %>